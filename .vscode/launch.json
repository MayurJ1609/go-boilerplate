{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug REST API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/rest",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.example",
      "env": {
        "HTTP_ADDR": ":8080"
      }
    },
    {
      "name": "Debug gRPC server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/grpc-server",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.example",
      "env": {
        "GRPC_ADDR": ":9090"
      }
    },
    {
      "name": "Debug gRPC client",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/grpc-client",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.example",
      "env": {
        "GRPC_TARGET": "localhost:9090"
      }
    },
    {
      "name": "Debug cron",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/cron",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.example",
      "env": {
        "CRON_SPEC": "@every 1m"
      }
    }
  ]
}
